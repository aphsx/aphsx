# Supabase (project ref: bjmqwerbslpdbfrkedqj)
# Dashboard → Project Settings → API
SUPABASE_URL=https://bjmqwerbslpdbfrkedqj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# The Odds API — https://the-odds-api.com (free tier ~500 req/month)
ODDS_API_KEY=

# Comma-separated sport keys (see GET /v4/sports). Free tier: keep this short.
ODDS_SOCCER_SPORT_KEYS=soccer_epl,soccer_uefa_champs_league,soccer_spain_la_liga

# Optional esports (Valorant often NOT on The Odds API — use ODDS_PAPI_KEY + adapter later)
ODDS_ESPORTS_SPORT_KEYS=

# Regions per call: cost = len(sports) * len(regions) credits per run
ODDS_REGIONS=eu,uk

# Only store matches starting within N days (default 7)
ODDS_LOOKAHEAD_DAYS=7

# Optional: OddsPapi for Valorant / CS2 (https://oddspapi.io)
ODDS_PAPI_KEY=
